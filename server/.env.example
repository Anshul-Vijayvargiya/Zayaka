# Copy to .env and fill in
PORT=5000
MONGO_URI=mongodb://localhost:27017/zayka
JWT_SECRET=zayka-super-secret-jwt-key-change-in-production-2026
CLIENT_URL=http://localhost:5173

# Email OTP via Brevo's HTTP API (not SMTP — Render's free tier blocks outbound SMTP ports)
# app.brevo.com -> Settings -> SMTP & API -> API Keys -> Generate a new key
BREVO_API_KEY=
# Sender address; must be a verified sender/domain in your Brevo account
MAIL_FROM_EMAIL=youraddress@example.com

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID, type Web)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Dev convenience: if BREVO_API_KEY is not set (or the API call fails), OTPs are logged to the server console
