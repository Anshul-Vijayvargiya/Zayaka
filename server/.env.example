# Copy to .env and fill in
PORT=5000
MONGO_URI=mongodb://localhost:27017/zayka
JWT_SECRET=zayka-super-secret-jwt-key-change-in-production-2026
CLIENT_URL=http://localhost:5173

# Email OTP (Gmail: enable 2FA, create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Zayka <youraddress@gmail.com>"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID, type Web)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Dev convenience: if SMTP is not configured, OTPs are logged to the server console
