# Bare origin of the backend — the client appends /api itself for REST calls
VITE_API_URL=http://localhost:5000
# Socket.io endpoint; falls back to VITE_API_URL, then localhost:5000, if unset
VITE_SOCKET_URL=http://localhost:5000
# Google OAuth Client ID (Web) — leave blank to hide the Google sign-in button
VITE_GOOGLE_CLIENT_ID=
